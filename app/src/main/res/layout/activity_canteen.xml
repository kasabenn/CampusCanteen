<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_header"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CAMPUSCANTEEN"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Pesanan Kamu — Kantin Mahasiswa Berketahanan Tinggi"
                    android:textSize="13sp"
                    android:textColor="#B2DFDB" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Section: Pilih Menu Makanan -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PILIH MENU MAKANAN"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.06"
                    android:layout_marginBottom="8dp" />

                <!-- Menu Item 1: Nasi Ayam Sambal Matah (Default & id: cardMenuChicken) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMenuChicken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="2dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍗"
                            android:textSize="28sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMenuName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nasi Ayam Sambal Matah"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvMenuPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 25.000"
                                android:textSize="14sp"
                                android:textColor="@color/primary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBadgeSelectedChicken"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dipilih"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:background="#E0F2F1"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Menu Item 2: Mie Ayam Bakso -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMenuNoodle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍜"
                            android:textSize="28sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMenuNoodleName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mie Ayam Bakso"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvMenuNoodlePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 18.000"
                                android:textSize="14sp"
                                android:textColor="@color/primary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBadgeSelectedNoodle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Menu Item 3: Rice Bowl Chicken -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMenuRiceBowl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍚"
                            android:textSize="28sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMenuRiceBowlName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rice Bowl Chicken"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvMenuRiceBowlPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 22.000"
                                android:textSize="14sp"
                                android:textColor="@color/primary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBadgeSelectedRiceBowl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Menu Item 4: Es Kopi Susu -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMenuCoffee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☕"
                            android:textSize="28sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMenuCoffeeName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Es Kopi Susu"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvMenuCoffeePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 12.000"
                                android:textSize="14sp"
                                android:textColor="@color/primary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBadgeSelectedCoffee"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Menu Item 5: Roti Bakar Coklat -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMenuToast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🍞"
                            android:textSize="28sp"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvMenuToastName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Roti Bakar Coklat"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvMenuToastPrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Rp 15.000"
                                android:textSize="14sp"
                                android:textColor="@color/primary"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBadgeSelectedToast"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pilih"
                            android:textSize="11sp"
                            android:textColor="@color/text_secondary"
                            android:background="#F1F5F9"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Input Quantity Stepper Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Jumlah Pesanan (Quantity)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnQtyMinus"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="0dp"
                                android:text="−"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilQuantity"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginHorizontal="10dp"
                                app:errorEnabled="true"
                                app:boxStrokeColor="@color/primary">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etQuantity"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:hint="Qty"
                                    android:inputType="number"
                                    android:text="2"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnQtyPlus"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="0dp"
                                android:text="+"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                app:cornerRadius="10dp" />

                        </LinearLayout>

                        <!-- Shortcut to test High Value order (> 10 juta) -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnShortcutHighValue"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="⚡ Uji Transaksi Besar (&gt;Rp10.000.000)"
                            android:textSize="12sp"
                            android:textColor="@color/warning" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section: Metode Pembayaran -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Metode Pembayaran"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <RadioGroup
                            android:id="@+id/rgPaymentMethod"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <RadioButton
                                android:id="@+id/rbQris"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="📱 QRIS Kantin Kampus"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />

                            <RadioButton
                                android:id="@+id/rbEwallet"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="💳 E-Wallet (GoPay / OVO / DANA)"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />

                            <RadioButton
                                android:id="@+id/rbCash"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="💵 Tunai Manual (Kasir Loket)"
                                android:textSize="14sp"
                                android:textColor="@color/text_primary" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section: Ringkasan Pesanan -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ringkasan Pesanan"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/stroke_color" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Menu Dipilih"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvOrderSummary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Nasi Ayam Sambal Matah"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Jumlah"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvQuantity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2 porsi"
                                android:textSize="13sp"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Metode Bayar"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvPaymentMethod"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="QRIS"
                                android:textSize="13sp"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="10dp"
                            android:background="@color/stroke_color" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Subtotal / Total"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvSubtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 50.000"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Section: Panel Simulasi Pengujian Error (Developer Testing Panel) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#CBD5E1"
                    app:strokeWidth="1.5dp"
                    app:cardBackgroundColor="#F1F5F9">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧪 Mode Pengujian (Simulator)"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Mode ini digunakan untuk simulasi error handling."
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary" />

                        <RadioGroup
                            android:id="@+id/rgSimulationMode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <RadioButton
                                android:id="@+id/rbSimNormal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="Pembayaran Normal"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbSimTimeout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Payment Timeout"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbSimMenuUnavailable"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Menu Tidak Tersedia"
                                android:textSize="13sp" />

                            <RadioButton
                                android:id="@+id/rbSimUnknownError"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Unexpected Error"
                                android:textSize="13sp" />
                        </RadioGroup>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Tombol Bayar Sekarang -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPayNow"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Bayar Sekarang"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    app:cornerRadius="14dp"
                    app:backgroundTint="@color/primary" />

                <!-- ProgressBar Proses Pembayaran -->
                <ProgressBar
                    android:id="@+id/progressPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:visibility="gone" />

                <!-- Card Hasil Pembayaran / Status Error / Success -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPaymentResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    app:strokeColor="@color/stroke_color"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface">

                    <LinearLayout
                        android:id="@+id/containerResultContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Status Title -->
                        <TextView
                            android:id="@+id/tvPaymentStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PEMBAYARAN BERHASIL"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/success_text" />

                        <!-- Detailed Message -->
                        <TextView
                            android:id="@+id/tvPaymentMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Pesanan sedang diproses di dapur kantin."
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:lineSpacingExtra="2dp" />

                        <!-- Divider -->
                        <View
                            android:id="@+id/dividerResult"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/stroke_color" />

                        <!-- Order Id -->
                        <LinearLayout
                            android:id="@+id/layoutOrderId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Order ID:"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvOrderId"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ORD-CC-2026-001"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <!-- Total Payment -->
                        <LinearLayout
                            android:id="@+id/layoutTotalPayment"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Total Pembayaran:"
                                android:textSize="13sp"
                                android:textColor="@color/text_secondary" />

                            <TextView
                                android:id="@+id/tvTotalPayment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 50.000"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />
                        </LinearLayout>

                        <!-- Retry Info Text -->
                        <TextView
                            android:id="@+id/tvRetryInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Percobaan 1 dari 3"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/warning"
                            android:visibility="gone" />

                        <!-- Action Buttons in Result Card -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="vertical">

                            <!-- Retry Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRetry"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:text="Coba Lagi"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:cornerRadius="12dp"
                                app:backgroundTint="@color/error" />

                            <!-- Cash Confirmation Button (for fallback recovery) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnConfirmCash"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="8dp"
                                android:text="Konfirmasi Pembayaran Tunai"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                app:cornerRadius="12dp"
                                app:backgroundTint="@color/warning" />

                            <!-- Reset / Pesan Lagi Button -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnOrderAgain"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="8dp"
                                android:text="Pesan Lagi"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:cornerRadius="12dp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
