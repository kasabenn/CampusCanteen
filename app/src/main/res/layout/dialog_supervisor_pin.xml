<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🔐 Otorisasi Supervisor"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvDialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nilai transaksi cukup besar (&gt; Rp10.000.000). Masukkan PIN Supervisor untuk melanjutkan transaksi pesanan kampus."
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="3dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilSupervisorPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxStrokeColor="@color/primary"
        app:hintTextColor="@color/primary"
        app:passwordToggleEnabled="true">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etSupervisorPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan PIN"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tvPinHintNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="* PIN otorisasi rahasia supervisor kantin"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="sans-serif-light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btnCancelPin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batal"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnAuthorizePin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/primary"
            android:text="Otorisasi"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
